{
  "name": "@reading-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db-generate": "drizzle-kit generate",
    "db-migrate": "tsx src/db/migrate.ts",
    "db-seed": "tsx src/db/seed.ts"
  },
  "nx": {
    "name": "api",
    "tags": [
      "scope:api"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@reading-tracker/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
