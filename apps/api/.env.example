# Copy to .env.local and change what you need.
# API settings. Loaded by `pnpm api:dev`, `api:start`, `api:db-migrate` and `api:db-seed`.
# Paths are relative to apps/api. Every value here is the default; change what you need.

# Where the API listens. Keep HOST=localhost so only the web app can reach it.
PORT=3333
HOST=localhost

# SQLite file. In production, point it outside the deploy folder (or at a mounted volume)
# so a fresh checkout doesn't replace your data, e.g. /var/lib/pageclock/reading-tracker.db
DATABASE_URL=./data/reading-tracker.db


# pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
