{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/eslint.config.mjs"],
    "production": ["default", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/**/*.test.tsx"]
  },
  "targetDefaults": {
    "dev": { "continuous": true, "cache": false },
    "build": { "dependsOn": ["^build"], "inputs": ["production", "^production"], "cache": true },
    "lint": { "inputs": ["default"], "cache": true },
    "typecheck": { "inputs": ["default", "^default"], "cache": true },
    "test": { "inputs": ["default", "^default"], "cache": true }
  }
}
